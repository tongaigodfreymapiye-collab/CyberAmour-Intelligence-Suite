# REQUIRED: use a random secret of at least 32 characters. Do not commit your real .env.
CYBERAMOUR_SENSOR_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
CYBERAMOUR_SENSOR_PORT=8765

# Allowed browser origins; comma-separated. Add only origins you control.
CYBERAMOUR_ALLOWED_ORIGINS=https://tongaigodfreymapiye-collab.github.io,http://localhost:3000,http://127.0.0.1:3000

# Optional explicit paths if command-line tools are not on PATH (Windows examples are commented).
# CLAMSCAN_BIN=C:\\Program Files\\ClamAV\\clamscan.exe
# TSHARK_BIN=C:\\Program Files\\Wireshark\\tshark.exe
# SURICATA_BIN=C:\\Program Files\\Suricata\\suricata.exe
# ZEEK_BIN=C:\\Program Files\\Zeek\\bin\\zeek.exe
# YARA_BIN=yara

# Optional YARA rule file or directory. Rule repository licenses still apply.
# YARA_RULES_PATH=C:\\CyberAmour\\rules\\index.yar

# Optional Splunk HTTP Event Collector. Use an HTTPS URL ending in /services/collector/event.
# Only summarized scan/PCAP metadata and alert events are forwarded; raw files/payloads are not.
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=main
ALLOW_HTTP_SPLUNK=false

# Safety/performance caps
MAX_UPLOAD_BYTES=104857600
MAX_PCAP_PACKETS=5000
